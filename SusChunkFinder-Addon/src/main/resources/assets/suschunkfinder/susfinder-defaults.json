{
  "_info": "Default thresholds for Sus Chunk Finder. Loaded from .minecraft/meteor-client/sus-chunk-finder/config.json. All values editable. 0 = disabled.",
  "heightZones": {
    "undergroundMaxY": 50,
    "surfaceMaxY": 100,
    "_note": "Zones only classify results. Vertical scan always goes from minBuildHeight to maxBuildHeight-1 (from world.getBottomY()/getTopY())."
  },
  "thresholds": {
    "valuable": {
      "obsidian": 16,
      "crying_obsidian": 4,
      "ancient_debris": 3,
      "netherite_block": 1,

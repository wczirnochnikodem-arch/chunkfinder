      "emerald_block": 3,
      "gold_block": 4,
      "iron_block": 8,
      "redstone_block": 8,
      "lapis_block": 4,
      "beacon": 1,
      "spawner": 1
    },
    "storage": {
      "chest": 3,
      "trapped_chest": 1,
      "barrel": 3,
      "shulker_box": 1,
      "ender_chest": 1,
      "furnace": 3,
      "blast_furnace": 2,
      "smoker": 2,
      "crafting_table": 2,
      "anvil": 1,
      "enchanting_table": 1
    },
    "redstone": {
      "redstone_wire": 20,
      "repeater": 3,
      "comparator": 3,
      "observer": 4,
      "piston": 4,
      "sticky_piston": 2,
      "dispenser": 3,
      "dropper": 3,
      "hopper": 5,
      "lever": 4,
      "button": 5,
      "pressure_plate": 3
    }
  },
  "scoring": {
    "levels": { "low": [0, 19], "moderate": [20, 39], "suspicious": [40, 69], "verySuspicious": [70, 100] },
    "weights": {
      "valuableBlockGroup": 12,
      "storageBlockGroup": 10,
      "redstoneGroup": 8,
      "playerModification": 15,
      "terrainAnomaly": 10,
      "artificialRoom": 14,
      "obsidianStructure": 12,
      "clusterBonus": 8
    },
    "multipliers": {
      "underground": 1.0,
      "surface": 1.0,
      "aboveY100": 1.3,
      "originSuspectedPlayer": 1.25,
      "originNatural": 0.3,
      "originUnknown": 1.0
    },
    "_note": "Each anomaly counted once (key = type + cluster position). Result clamped to 0-100."
  },
  "naturalFilters": {
    "ignoreCaves": true,
    "ignoreGeodes": true,
    "ignoreVanillaStructures": ["village", "stronghold", "mineshaft", "ancient_city", "bastion", "fortress", "end_city", "trial_chamber", "ruined_portal", "desert_pyramid", "jungle_temple", "ocean_monument", "woodland_mansion", "trail_ruins"]
  },
  "performance": {
    "chunksPerTick": 1,
    "sectionsPerTick": 4,
    "scanDistanceChunks": 8,
    "rescanOnlyOnChange": true
  },
  "export": { "format": "json", "directory": "meteor-client/sus-chunk-finder/exports" }
}
